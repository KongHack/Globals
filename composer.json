{
    "name": "gcworld/globals",
    "type": "library",
    "description": "Globals",
    "homepage": "https://gamecharmer.com",
    "license": "MIT",
    "authors": [
        {
            "name": "GameCharmer",
            "email": "admin@gamecharmer.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-json":"*",
        "ext-mbstring": "*",
        "ramsey/uuid": "^4.9"
    },
    "autoload": {
        "psr-4": {
            "GCWorld\\Globals\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GCWorld\\Globals\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "test": "phpunit",
        "check": [
            "@lint",
            "@test"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    }
}
